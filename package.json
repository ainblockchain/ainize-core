{
  "name": "@ainize/core",
  "version": "0.2.1",
  "description": "Ainize core \u2014 knowledge-patch schemas, lineage, verification and ledger (AIN) bindings shared by @ainize/node and @ainize/cli",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ainblockchain/ainize-core.git"
  },
  "homepage": "https://github.com/ainblockchain/ainize",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@ainblockchain/ain-js": "^1.15.0",
    "@ainblockchain/ain-util": "^1.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}